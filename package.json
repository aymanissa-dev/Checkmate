{
  "name": "checkmate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Checkmate - a modern web chess app: play against a built-in AI with full rules, checkmate detection, move history and captured-piece tracking.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^19.2.8",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  }
}
