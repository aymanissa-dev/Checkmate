# Optional: required only for real LLM baseline / Checkmate runs.
# Dry-run / mock mode works without any API key.
# Never commit a filled .env — see PROVIDE_CHECKLIST.md
#
# Default provider: Hugging Face (when CHECKMATE_MODEL_PROVIDER is unset).
# OpenAI is optional / secondary — only used when CHECKMATE_MODEL_PROVIDER=openai.

# HF_TOKEN=                    # required for live eval (default provider)
# HUGGINGFACE_API_KEY=         # alias for HF_TOKEN
# OPENAI_API_KEY=              # only if CHECKMATE_MODEL_PROVIDER=openai
# ANTHROPIC_API_KEY=           # reserved; Anthropic provider not implemented yet
# CHECKMATE_MODEL_PROVIDER=    # default: huggingface | also: hf | openai | mock
# CHECKMATE_MODEL=             # default (HF): Qwen/Qwen2.5-Coder-7B-Instruct; openai: gpt-4o-mini
# HF_BASE_URL=https://router.huggingface.co/v1   # optional OpenAI-compatible router override
# CHECKMATE_HF_NATIVE_TOOLS=1  # optional: also send OpenAI-style tools (JSON mode remains primary)
# CHECKMATE_DRY_RUN=1          # force mock even if a key is present
